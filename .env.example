# MongoDB Atlas Connection String
# 1. Create a free cluster on https://www.mongodb.com/cloud/atlas
# 2. Click "Connect" -> "Drivers" -> Copy your connection string
# 3. Paste it below and replace <password> with your database user password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sanzartourz?retryWrites=true&w=majority
MONGODB_DB=sanzartourz

